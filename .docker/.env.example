# Cổng truy cập từ máy host (http://localhost:8090)
PORT=8090

# Múi giờ hệ thống
TZ=Asia/Ho_Chi_Minh

# Bật chế độ dev (hiển thị log SQL/request chi tiết và tự động seed dữ liệu mẫu)
PB_DEV=false

# Tự động khởi tạo / cấp quyền Admin cho tài khoản khi container khởi động (tuỳ chọn)
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=Password123!

